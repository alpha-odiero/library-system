{
  "name": "@lms/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Library Management System API - the security boundary",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:deploy": "tsx scripts/deploy.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate && prisma format --check",
    "db:format": "prisma format",
    "db:drift": "tsx scripts/check-migration-drift.ts",
    "db:invariants": "psql -v ON_ERROR_STOP=1 -f ./scripts/invariant-checks.sql",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@lms/shared": "*",
    "@prisma/client": "6.16.2",
    "argon2": "0.44.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.1",
    "jose": "^6.1.0",
    "pino": "9.9.4",
    "pino-http": "10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.36.0",
    "pino-pretty": "13.1.2",
    "prisma": "6.16.2",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "4.1.11"
  }
}
