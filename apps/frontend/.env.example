# Client environment variables. ALL VITE_* values are inlined into the public
# browser bundle at build time, so nothing in this file can be a secret.
#
# The API the built SPA calls. Relative (`/api/v1`) by default: in development
# the Vite dev proxy (vite.config.ts) forwards /api, /health and /ready to the
# local backend, so the browser never leaves one origin. Use an absolute URL only
# when the deployed SPA talks to an API on a DIFFERENT origin, e.g.
#   VITE_API_BASE_URL=https://library-system-jdge.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Must match the backend's CSRF_COOKIE_NAME / CSRF_HEADER_NAME. These already
# match the server's defaults, so they only need changing if the backend is
# configured differently — a mismatch surfaces as a 403 that looks like a
# permission problem.
VITE_CSRF_COOKIE_NAME=lms_csrf
VITE_CSRF_HEADER_NAME=x-csrf-token

# Presentation metadata (display only).
VITE_APP_NAME=Soma360
VITE_APP_VERSION=1.0.0