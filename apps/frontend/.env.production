# Build-time API base URL for the deployed SPA.
#
# Vite inlines every VITE_* value into the public bundle, so this is public
# client configuration, never a secret. An existing process/env value set at the
# host (Vercel/Netlify/Render build settings) takes precedence over this file.
VITE_API_BASE_URL=https://library-system-jdge.onrender.com/api/v1