{
  "name": "@lms/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Contracts shared by the backend and frontend: permission registry, error codes, DTO schemas",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "22.18.6",
    "eslint": "9.36.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "4.1.11"
  }
}
