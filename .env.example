# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of the API (used for absolute links, e.g. receipt URLs)
API_URL=http://localhost:4000

# ── Frontend / CORS ─────────────────────────────────────────────────────────
# Explicit allowlist. Comma-separated. Wildcard (*) is REJECTED at startup in production.
FRONTEND_URL=http://localhost:5173
# Optional additional allowed origins (comma-separated)
CORS_EXTRA_ORIGINS=
COOKIE_DOMAIN=

# ── Database ───────────────────────────────────────────────────────────────
# Standard local PostgreSQL for development.
# pooled/runtime connection (PgBouncer or direct)
DATABASE_URL=******localhost:5432/lms?schema=public&connection_limit=10
# direct connection, required by Prisma Migrate for DDL
DIRECT_URL=******localhost:5432/lms?schema=public
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ── Secrets (REQUIRED — startup fails fast if missing/insecure) ─────────────
# Generate: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-only-insecure-refresh-secret-change-me-00000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# Cookie SameSite. Keep `lax` (same-site SPA, incl. the dev proxy). A SPA served
# from a DIFFERENT site (Vercel/Netlify) needs `none` AND COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Password hashing (Argon2id) ─────────────────────────────────────────────
# OWASP baseline: 19 MiB memory, 2 iterations, parallelism 1
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── CSRF ───────────────────────────────────────────────────────────────────
CSRF_COOKIE_NAME=lms_csrf
CSRF_HEADER_NAME=x-csrf-token

# ── Localisation / money ───────────────────────────────────────────────────
CURRENCY=KES
TIMEZONE=Africa/Nairobi

# ── Object storage (covers, digital resources) ──────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SIGNED_URL_TTL_SECONDS=300

# ── Email (optional; falls back to console transport) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@library.local
REQUIRE_EMAIL_VERIFICATION=false

# ── SMS / M-Pesa (optional, modular) ────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox

# ── Redis (optional; in-memory fallbacks used when absent) ─────────────────
REDIS_URL=

# ── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
ENABLE_REQUEST_LOGGING=true

# ── Jobs ───────────────────────────────────────────────────────────────────
JOBS_ENABLED=true
OVERDUE_SWEEP_CRON=0 * * * *
RESERVATION_EXPIRY_CRON=*/15 * * * *
SESSION_PURGE_CRON=17 3 * * *

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# These are the only secrets the browser bundle ever sees, and none of them are
# secrets: Vite inlines them at build time, so anything listed here is public.
#
# Only needed when the backend does NOT run on the same origin behind a proxy.
# Same-origin deploys need none of them — the client falls back to /api/v1 and
# the backend's own defaults.
#
# Must match the backend's CSRF_COOKIE_NAME / CSRF_HEADER_NAME above. Changing a
# name on one side without the other produces a 403 that looks like a
# permissions problem.
VITE_API_BASE_URL=/api/v1
VITE_CSRF_COOKIE_NAME=lms_csrf
VITE_CSRF_HEADER_NAME=x-csrf-token